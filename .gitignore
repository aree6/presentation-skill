# Installed tooling, never committed. Restore with:
#   npm install && npx playwright install chromium
node_modules/
package-lock.json

# Generated output. `shot` writes these beside whatever deck it is given, which
# includes the bundled templates. `frames` writes *-motion/ the same way.
# Both are derived and regenerable, so neither is committed.
presentations/
*-shots/
*-motion/

# One folder per deck, inside the skill. The deck, its plan, its PDF and its
# images are the deliverable and stay tracked; screenshots and motion frames
# are derived, large, and regenerable (covered by the globals above, kept
# here to state the rule for decks explicitly).
decks/*/*-shots/
decks/*/*-motion/

# Generated browser-side icon search data. Restore with:
#   bun cli.mjs icons build
assets/icon-index.js
assets/icon-files/
